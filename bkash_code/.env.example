# BKASH_APP_SECRET=your_live_app_secret

# Must be a publicly reachable URL that bKash can redirect the browser to
# after payment. Use ngrok or similar for local testing.
BKASH_CALLBACK_URL=http://localhost:4000/api/payments/bkash/callback

